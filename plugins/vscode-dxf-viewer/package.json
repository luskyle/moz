{
  "name": "moz-dxf-viewer",
  "displayName": "Moz DXF/DWG Viewer",
  "description": "在 VS Code 里直接查看 DXF/DWG 图纸：点击文件即打开，**可交互的原始图纸**（图层开关、悬停看图层/点选看图元、滚轮缩放、拖动平移）。自带 libdxfrw 渲染后端（.so + Python），装好即用。",
  "version": "0.2.4",
  "publisher": "luskyle",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/luskyle/moz"
  },
  "galleryBanner": {
    "color": "#1857e0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": ["dxf", "dwg", "librecad", "libdxfrw", "cad", "visualization"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mozDxfViewer.show",
        "title": "Moz: 查看 DXF/DWG 图纸",
        "icon": "$(preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "mozDxfViewer.editor",
        "displayName": "Moz DXF/DWG 图纸",
        "selector": [
          { "filenamePattern": "*.dxf" },
          { "filenamePattern": "*.dwg" }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mozDxfViewer.show",
          "when": "resourceExtname =~ /\\.(dxf|dwg)/i",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "mozDxfViewer.show",
          "when": "resourceExtname =~ /\\.(dxf|dwg)/i"
        }
      ]
    },
    "configuration": {
      "title": "Moz DXF/DWG Viewer",
      "properties": {
        "mozDxfViewer.python": {
          "type": "string",
          "default": "python3",
          "description": "跑渲染后端的 Python 解释器（仅 Python 3.8+ 即可，无需 PySide6）。Windows 上可填 python.exe 的完整路径。"
        },
        "mozDxfViewer.backendPyDir": {
          "type": "string",
          "default": "",
          "description": "换成仓库的 py/ 目录时指定（开发/想用最新代码时）。留空：优先用扩展自带的 python/（含 .so）。"
        },
        "mozDxfViewer.buildBackend": {
          "type": "boolean",
          "default": true,
          "description": "用仓库后端时，libmozcadio.so 缺失自动跑 `scripts/build_moz_cadio.sh`（首次约 1-2 分钟）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle-backend": "bash scripts/bundle-backend.sh",
    "package": "rm -f *.vsix && npm run bundle-backend && vsce package --no-dependencies",
    "deploy": "npm run bundle-backend && vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}